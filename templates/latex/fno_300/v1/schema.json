{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["org", "period", "sales_tenge", "vat_charged_tenge", "vat_credited_tenge", "balance_tenge", "balance_kind", "balance_words", "signed_on", "director", "accountant"],
  "properties": {
    "org": {"$ref": "#/definitions/org"},
    "period": {"$ref": "#/definitions/period"},
    "sales_tenge": {"type": "string"},
    "vat_charged_tenge": {"type": "string"},
    "vat_credited_tenge": {"type": "string"},
    "balance_tenge": {"type": "string"},
    "balance_kind": {"type": "string", "enum": ["to_pay", "to_refund"]},
    "balance_words": {"type": "string"},
    "signed_on": {"type": "string", "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$"},
    "director": {"type": "string"},
    "accountant": {"type": "string"}
  },
  "definitions": {
    "org": {
      "type": "object",
      "required": ["bin", "name"],
      "properties": {
        "bin": {"type": "string"}, "name": {"type": "string"}
      }
    },
    "period": {
      "type": "object",
      "required": ["year", "quarter"],
      "properties": {
        "year": {"type": "string", "pattern": "^\\d{4}$"},
        "quarter": {"type": "string", "enum": ["1", "2", "3", "4"]}
      }
    }
  }
}
